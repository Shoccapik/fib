<!DOCTYPE html>
<html>
<head>
    <title>FIB Portal</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="layout">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <img src="/images/FIB_V2.png" alt="Logo FIB" class="sidebar-logo">

        <a href="/auth/dashboard" class="active">Dashboard</a>
        <a href="/citizens">Citoyens</a>
        <a href="/reports">Rapports</a>
        <a href="/service">Service</a>
        <a href="/messages">Messages</a>
        <% if (user && user.accreditation === 1) { %>
        <a href="/users/admin">Admin Utilisateurs</a>
        <a href="/logs/admin">Admin Logs</a>
        <% } %>

        <div class="logout">
            <a href="/logout">Déconnexion</a>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main">

        <!-- TOPBAR -->
        <div class="topbar">
            <div>
                <h1>Dashboard</h1>
                <p class="subtitle">Système interne sécurisé</p>
            </div>

            <div class="user-info">
                <span>Agent : <%= user.username %></span>
                <span class="online">● En ligne</span>
            </div>
        </div>

        <!-- CARDS -->
        <div class="cards">

            <div class="card">
                <h3>Agents en service</h3>
                <p><%= onDuty || 0 %></p>
                <span class="card-info">En service actuellement</span>
            </div>

            <div class="card">
                <h3>Rapports</h3>
                <p><%= totalReports || 0 %></p>
                <span class="card-info">Total</span>
            </div>

            <div class="card">
                <h3>Citoyens fichés</h3>
                <p><%= totalCitizens || 0 %></p>
                <span class="card-info">Total</span>
            </div>

            <div class="card">
                <h3>Temps service total</h3>
                <p><%= totalServiceDuration || '00:00:00' %></p>
                <span class="card-info">Total cumulé</span>
            </div>

        </div>

        <div class="activity ranking-panel">
            <div class="activity-heading">
                <div>
                    <p class="section-kicker">Performance opérationnelle</p>
                    <h2>Classement heures de service</h2>
                </div>
                <span class="activity-caption">Top agents</span>
            </div>
            <% if (serviceRanking && serviceRanking.length > 0) { %>
                <% serviceRanking.forEach((entry, index) => { %>
                    <div class="ranking-row">
                        <span class="ranking-position"><%= index + 1 %></span>
                        <div class="ranking-avatar"><%= entry.username.charAt(0).toUpperCase() %></div>
                        <div class="ranking-agent">
                            <strong><%= entry.username %></strong>
                            <div class="ranking-track"><span style="width: <%= serviceRanking[0].hours ? Math.min(100, (entry.hours / serviceRanking[0].hours) * 100) : 0 %>%"></span></div>
                        </div>
                        <strong class="ranking-duration"><%= entry.duration || '00:00:00' %></strong>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-dashboard">Aucun service démarré.</div>
            <% } %>
        </div>

        <!-- ACTIVITÉ RÉCENTE -->
        <div class="activity recent-panel">
            <div class="activity-heading">
                <div>
                    <p class="section-kicker">Journal du MDT</p>
                    <h2>Activité récente</h2>
                </div>
                <span class="activity-caption">Dernières actions</span>
            </div>

            <% recentReports.forEach(report => { %>
            <a class="recent-item" href="/reports/<%= report.id %>">
                <span class="recent-icon report-icon">R</span>
                <span class="recent-item-content">
                    <strong>Nouveau rapport</strong>
                    <span><%= report.title %></span>
                </span>
                <time datetime="<%= report.created_at %>"><%= new Date(report.created_at).toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit'}) %></time>
            </a>
            <% }) %>

            <% recentCitizens.forEach(citizen => { %>
            <a class="recent-item" href="/citizens/<%= citizen.id %>">
                <span class="recent-icon citizen-icon">C</span>
                <span class="recent-item-content">
                    <strong>Nouveau dossier citoyen</strong>
                    <span><%= citizen.prenom %> <%= citizen.nom %></span>
                </span>
                <span class="recent-arrow">›</span>
            </a>
            <% }) %>

        </div>

        </div>

    </div>

</div>

</body>
</html>