<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inscription FIB</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">

<div class="login-container">

    <div class="login-box">

        <img src="/images/FIB_V2.png" alt="Logo du FIB" class="access-logo">

        <h1>Inscription</h1>
        <p class="subtitle">Soumettez une demande de création de compte FIB</p>

        <% if (notice) { %>
        <p class="register-feedback register-feedback-<%= notice.type %>" role="status"><%= notice.text %></p>
        <% } %>

        <form method="POST" action="/auth/register">

            <div class="input-group">
                <input name="username" type="text" maxlength="50" autocomplete="username" required>
                <label>Nom d'utilisateur</label>
            </div>

            <div class="input-group">
                <input type="password" name="password" minlength="6" maxlength="72" autocomplete="new-password" required>
                <label>Mot de passe</label>
            </div>

            <div class="input-group">
                <select name="grade_title" required aria-label="Grade demandé" style="width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 5px; border: 1px solid #334155; background: #080f1f; color: white;">
                    <option value="" disabled selected>Choisir un grade</option>
                    <optgroup label="Niveau 1">
                        <option value="Director">Director</option>
                        <option value="Deputy Director">Deputy Director</option>
                        <option value="Associate Deputy Director">Associate Deputy Director</option>
                    </optgroup>
                    <optgroup label="Niveau 2">
                        <option value="Special Agent In Charge">Special Agent In Charge</option>
                        <option value="Assistant Special Agent In Charge">Assistant Special Agent In Charge</option>
                        <option value="Deputy Special Agent In Charge">Deputy Special Agent In Charge</option>
                        <option value="Supervisory Special Agent">Supervisory Special Agent</option>
                    </optgroup>
                    <optgroup label="Niveau 3">
                        <option value="Special Agent">Special Agent</option>
                    </optgroup>
                    <optgroup label="Niveau 4">
                        <option value="Probation Agent">Probation Agent</option>
                    </optgroup>
                </select>
            </div>

            <button class="btn" type="submit">S'inscrire</button>

        </form>

        <p class="register-approval-note">Votre compte restera en attente et ne pourra pas être utilisé avant sa validation par un membre d’accréditation 1.</p>
        <p style="margin-top: 20px;"><a href="/" style="color: #1f3cff;">Déjà un compte ? Se connecter</a></p>

    </div>

</div>

</body>
</html>