<!DOCTYPE html>
<html>
<head>
    <title>Modifier le rapport</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="layout">

    <div class="sidebar">
        <img src="/images/FIB_V2.png" alt="Logo FIB" class="sidebar-logo">
        <a href="/auth/dashboard">Dashboard</a>
        <a href="/citizens">Citoyens</a>
        <a href="/reports" class="active">Rapports</a>
        <a href="/service">Service</a>
        <a href="/messages">Messages</a>
        <% if (user && user.accreditation <= 2) { %>
        <a href="/users/admin">Admin Utilisateurs</a>
        <a href="/logs/admin">Admin Logs</a>
        <% } %>
        <div class="logout"><a href="/logout">Déconnexion</a></div>
    </div>

    <div class="main">
        <div class="topbar">
            <h1>Éditer le rapport</h1>
        </div>

        <div class="report-form">
            <form method="POST" action="/reports/<%= report.id %>/update">
                <input name="title" value="<%= report.title %>" required>
                <textarea name="content" required><%= report.content %></textarea>
                <select name="level">
                    <option value="1" <%= report.level === 1 ? 'selected' : '' %>>Public</option>
                    <option value="2" <%= report.level === 2 ? 'selected' : '' %>>Confidentiel</option>
                    <option value="3" <%= report.level === 3 ? 'selected' : '' %>>Secret</option>
                </select>

                <input name="personnes_concernees" value="<%= report.personnes_concernees %>" placeholder="Personnes concernées">
                <input name="agents_concernes" value="<%= report.agents_concernes %>" placeholder="Agents concernés">
                <input name="vehicules" value="<%= report.vehicules %>" placeholder="Véhicules">
                <input name="plaques" value="<%= report.plaques %>" placeholder="Plaques">
                <input name="armes" value="<%= report.armes %>" placeholder="Armes">
                <input name="numeros_serie" value="<%= report.numeros_serie %>" placeholder="Numéros de série">

                <button class="btn" type="submit">Enregistrer les modifications</button>
            </form>
            <a href="/reports/<%= report.id %>" class="btn-back report-edit-back">Annuler et revenir au rapport</a>
        </div>
    </div>

</div>

</body>
</html>