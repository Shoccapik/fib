<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Modifier le rapport #<%= report.id %> - FIB</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
    <nav class="sidebar" aria-label="Navigation principale">
        <img src="/images/FIB_V2.png" alt="Logo FIB" class="sidebar-logo">
        <a href="/auth/dashboard">Dashboard</a>
        <a href="/citizens">Citoyens</a>
        <a href="/reports" class="active">Rapports</a>
        <a href="/groups">Dossiers groupes</a>
        <a href="/service">Service</a>
        <a href="/messages">Messages</a>
        <% if (user && user.accreditation <= 2) { %>
        <a href="/users/admin">Admin Utilisateurs</a>
        <a href="/logs/admin">Admin Logs</a>
        <% } %>
        <div class="logout"><a href="/logout">Déconnexion</a></div>
    </nav>

    <main class="main report-edit-page">
        <header class="topbar report-edit-topbar">
            <div>
                <a class="report-edit-breadcrumb" href="/reports">← Retour aux rapports</a>
                <p class="page-kicker">Registre MDT · Modification</p>
                <h1>Modifier le rapport</h1>
                <p class="subtitle">Mettez à jour le contenu et les informations opérationnelles du dossier.</p>
            </div>
            <span class="report-edit-reference">RÉFÉRENCE #<%= report.id %></span>
        </header>

        <article class="report-edit-shell">
            <div class="report-edit-heading">
                <div>
                    <p class="section-kicker">Dossier sélectionné</p>
                    <h2><%= report.title || 'Rapport sans titre' %></h2>
                </div>
                <span class="report-edit-lock">ÉDITION SÉCURISÉE</span>
            </div>

            <form method="POST" action="/reports/<%= report.id %>/update" class="report-edit-form">
                <section class="report-edit-section" aria-labelledby="report-edit-general-title">
                    <div class="report-edit-section-heading">
                        <span class="report-edit-section-number">01</span>
                        <div>
                            <h3 id="report-edit-general-title">Informations générales</h3>
                            <p>Identifiez et classez le rapport.</p>
                        </div>
                    </div>

                    <div class="report-edit-fields">
                        <label class="report-edit-field report-edit-field-title">
                            <span>Titre du rapport</span>
                            <input name="title" value="<%= report.title || '' %>" maxlength="100" placeholder="Titre du rapport" required>
                        </label>

                        <label class="report-edit-field">
                            <span>Type de rapport</span>
                            <% if (report.report_type === 'Dossier') { %>
                            <input type="hidden" name="report_type" value="Dossier">
                            <span class="report-edit-fixed-value"><%= reportTypeLabel(report.report_type) %></span>
                            <% } else { %>
                            <select name="report_type">
                                <% reportTypeOptions.forEach(type => { %><option value="<%= type.value %>" <%= report.report_type === type.value ? 'selected' : '' %>><%= type.label %></option><% }) %>
                            </select>
                            <% } %>
                        </label>

                        <label class="report-edit-field">
                            <span>Niveau de confidentialité</span>
                            <select name="level" required>
                                <% Object.entries(reportLevels).forEach(([level, label]) => { %><option value="<%= level %>" <%= Number(report.level) === Number(level) ? 'selected' : '' %>><%= label %></option><% }) %>
                            </select>
                        </label>

                        <label class="report-edit-field report-edit-field-wide">
                            <span>Dossier groupe associé <small>(facultatif)</small></span>
                            <input name="group_name" value="<%= report.group_name || '' %>" placeholder="Nom du groupe ou de l'affiliation">
                        </label>

                        <label class="report-edit-field report-edit-field-wide">
                            <span>Contenu du rapport</span>
                            <textarea name="content" rows="9" placeholder="Décrivez les faits, le contexte et les mesures prises..." <%= report.report_type !== 'Dossier' ? 'required' : '' %>><%= report.content || '' %></textarea>
                            <small class="report-edit-help">Les retours à la ligne et les liens présents dans le texte seront conservés.</small>
                        </label>
                    </div>
                </section>

                <section class="report-edit-section" aria-labelledby="report-edit-operational-title">
                    <div class="report-edit-section-heading">
                        <span class="report-edit-section-number">02</span>
                        <div>
                            <h3 id="report-edit-operational-title">Informations opérationnelles</h3>
                            <p>Complétez les personnes, agents et équipements concernés.</p>
                        </div>
                    </div>

                    <div class="report-edit-operational-fields report-operational-fields">
                        <label class="report-operational-field">
                            <span>Personnes concernées</span>
                            <input name="personnes_concernees" value="<%= report.personnes_concernees || '' %>" placeholder="Noms ou références">
                        </label>
                        <label class="report-operational-field">
                            <span>Agents concernés</span>
                            <input name="agents_concernes" value="<%= report.agents_concernes || '' %>" placeholder="Noms ou matricules">
                        </label>

                        <section class="report-equipment-list" data-equipment-list
                            data-primary-label="Véhicule"
                            data-secondary-label="Plaque"
                            data-primary-placeholder="Modèle ou description du véhicule"
                            data-secondary-placeholder="Immatriculation">
                            <div class="report-equipment-heading">
                                <div><h3>Véhicules</h3><p>Associez chaque véhicule à sa plaque.</p></div>
                                <button class="report-equipment-add" type="button" data-add-equipment>+ Ajouter un véhicule</button>
                            </div>
                            <div class="report-equipment-rows" data-equipment-rows></div>
                            <p class="report-equipment-empty" data-equipment-empty>Aucun véhicule ajouté.</p>
                            <textarea hidden name="vehicules" data-primary-values><%= report.vehicules || '' %></textarea>
                            <textarea hidden name="plaques" data-secondary-values><%= report.plaques || '' %></textarea>
                        </section>

                        <section class="report-equipment-list" data-equipment-list
                            data-primary-label="Arme"
                            data-secondary-label="N° de série"
                            data-primary-placeholder="Type ou description de l'arme"
                            data-secondary-placeholder="Numéro de série">
                            <div class="report-equipment-heading">
                                <div><h3>Armes</h3><p>Associez chaque arme à son numéro de série.</p></div>
                                <button class="report-equipment-add" type="button" data-add-equipment>+ Ajouter une arme</button>
                            </div>
                            <div class="report-equipment-rows" data-equipment-rows></div>
                            <p class="report-equipment-empty" data-equipment-empty>Aucune arme ajoutée.</p>
                            <textarea hidden name="armes" data-primary-values><%= report.armes || '' %></textarea>
                            <textarea hidden name="numeros_serie" data-secondary-values><%= report.numeros_serie || '' %></textarea>
                        </section>
                    </div>
                </section>

                <footer class="report-edit-actions">
                    <a href="/reports/<%= report.id %>" class="report-edit-cancel">Annuler</a>
                    <button class="btn report-edit-save" type="submit"><span aria-hidden="true">✓</span> Enregistrer les modifications</button>
                </footer>
            </form>
        </article>
    </main>
</div>
<script src="/js/report-equipment.js"></script>
<script src="/js/site-presence.js" data-user-id="<%= user.id %>"></script>
</body>
</html>
