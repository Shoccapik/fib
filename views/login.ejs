<!DOCTYPE html>
<html>
<head>
    <title>FIB Secure Access</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">

<div class="login-container">

    <div class="login-box">

        <img src="/images/FIB_V2.png" alt="Logo du FIB" class="access-logo">

        <div class="login-heading">
            <p class="login-kicker">FIB / MDT</p>
            <h1>Accès sécurisé</h1>
            <p class="login-subtitle">Interface opérationnelle interne</p>
        </div>

        <form method="POST" action="/auth/login">

            <div class="input-group">
                <input name="username" autocomplete="username" required>
                <label>Identifiant agent</label>
            </div>

            <div class="input-group">
                <input type="password" name="password" autocomplete="current-password" required>
                <label>Mot de passe</label>
            </div>

            <button class="btn">Accès sécurisé</button>

        </form>

        <p class="register-link"><a href="/auth/register">Créer un compte agent</a></p>

        <p class="warning"><span>!</span> Accès réservé au personnel autorisé</p>

    </div>

</div>

</body>
</html>

