<!DOCTYPE html>
<html>
<head>
    <title>FIB Secure Access</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">

<div class="login-container">

    <div class="login-box">

        <img src="/images/FIB.png" alt="Logo du FIB">

        <form method="POST" action="/auth/login">

            <div class="input-group">
                <input name="username" required>
                <label>Username</label>
            </div>

            <div class="input-group">
                <input type="password" name="password" required>
                <label>Password</label>
            </div>

            <button class="btn">Accès sécurisé</button>

        </form>

        <p><a href="/auth/register">Créer un compte</a></p>

        <p class="warning">⚠ Accès réservé au personnel autorisé</p>

    </div>

</div>

</body>
</html>

