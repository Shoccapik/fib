<!DOCTYPE html>
<html>
<head>
    <title>FIB - Citoyens</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="layout">

    <div class="sidebar">
        <img src="/images/FIB_V2.png" alt="Logo FIB" class="sidebar-logo">
        <a href="/auth/dashboard">Dashboard</a>
        <a href="/citizens" class="active">Citoyens</a>
        <a href="/reports">Rapports</a>
        <a href="/service">Service</a>
        <a href="/messages">Messages</a>
        <% if (user && user.accreditation <= 2) { %>
        <a href="/users/admin">Admin Utilisateurs</a>
        <a href="/logs/admin">Admin Logs</a>
        <% } %>
        <div class="logout">
            <a href="/logout">Déconnexion</a>
        </div>
    </div>

    <div class="main">
        <div class="topbar">
            <div>
                <p class="page-kicker">Base civile du MDT</p>
                <h1>Citoyens</h1>
                <p class="subtitle">Dossiers et identités enregistrés par le FIB</p>
            </div>
            <div class="user-info">
                <span>Registre actif</span>
                <strong><%= citizens.length %> dossier<%= citizens.length > 1 ? 's' : '' %></strong>
            </div>
        </div>

        <div class="report-form citizen-create-form">
            <div class="citizen-section-heading">
                <div>
                    <p class="section-kicker">Nouveau dossier</p>
                    <h2>Ajouter un citoyen</h2>
                </div>
                <span class="form-badge">FIB / MDT</span>
            </div>
            <form method="POST" action="/citizens/create">
                <input name="nom" placeholder="Nom" aria-label="Nom" required>
                <input name="prenom" placeholder="Prénom" aria-label="Prénom" required>
                <input name="dob" type="date" aria-label="Date de naissance" required>
                <button class="btn" type="submit">Créer le dossier</button>
            </form>
        </div>

        <div class="reports-list">
            <div class="citizen-section-heading">
                <div>
                    <p class="section-kicker">Registre MDT</p>
                    <h2>Liste des citoyens</h2>
                </div>
                <span class="reports-count"><%= citizens.length %> résultat<%= citizens.length > 1 ? 's' : '' %></span>
            </div>
            <% if (citizens.length === 0) { %>
                <p class="empty-dashboard">Aucun citoyen enregistré.</p>
            <% } else { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Dossier</th>
                            <th>Identité</th>
                            <th>Date de naissance</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% citizens.forEach(citizen => { %>
                            <tr>
                                <td><a class="citizen-id" href="/citizens/<%= citizen.id %>">#<%= citizen.id %></a></td>
                                <td><a class="citizen-identity" href="/citizens/<%= citizen.id %>"><span class="citizen-avatar"><%= citizen.prenom.charAt(0).toUpperCase() %><%= citizen.nom.charAt(0).toUpperCase() %></span><span><strong><%= citizen.prenom %> <%= citizen.nom %></strong><small>Fiche citoyen</small></span></a></td>
                                <td><span class="citizen-date"><%= new Date(citizen.dob).toLocaleDateString('fr-FR') %></span></td>
                                <td><a class="table-action" href="/citizens/<%= citizen.id %>">Ouvrir <span>›</span></a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>

</div>

</body>
</html>
