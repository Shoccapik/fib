<!DOCTYPE html>
<html>
<head>
    <title>FIB - Détails Citoyen</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="layout">

    <div class="sidebar">
        <img src="/images/FIB_V2.png" alt="Logo FIB" class="sidebar-logo">
        <a href="/auth/dashboard">Dashboard</a>
        <a href="/citizens">Citoyens</a>
        <a href="/reports">Rapports</a>
        <a href="/service">Service</a>
        <a href="/messages">Messages</a>
        <% if (user && user.accreditation <= 2) { %>
        <a href="/users/admin">Admin Utilisateurs</a>
        <a href="/logs/admin">Admin Logs</a>
        <% } %>
        <div class="logout">
            <a href="/logout">Déconnexion</a>
        </div>
    </div>

    <div class="main">
        <div class="topbar">
            <div>
                <p class="page-kicker">Dossier citoyen #<%= citizen.id %></p>
                <h1><%= citizen.prenom %> <%= citizen.nom %></h1>
                <p class="subtitle">Fiche consultable dans le registre du FIB</p>
            </div>
        </div>

        <div class="citizen-profile">
            <div class="citizen-profile-identity">
                <div class="citizen-profile-avatar"><%= citizen.prenom.charAt(0).toUpperCase() %><%= citizen.nom.charAt(0).toUpperCase() %></div>
                <div>
                    <p class="section-kicker">Identité enregistrée</p>
                    <h2><%= citizen.prenom %> <%= citizen.nom %></h2>
                    <span class="citizen-status">Dossier actif</span>
                </div>
            </div>
            <div class="citizen-facts">
                <div><span>Référence</span><strong>#<%= citizen.id %></strong></div>
                <div><span>Date de naissance</span><strong><%= new Date(citizen.dob).toLocaleDateString('fr-FR') %></strong></div>
                <div><span>Téléphone</span><strong><%= citizen.phone || 'Non renseigné' %></strong></div>
                <div><span>Profession</span><strong><%= citizen.job || 'Non renseignée' %></strong></div>
                <div><span>Affiliation</span><strong><%= citizen.affiliation || 'Aucune' %></strong></div>
                <div><span>Enregistré le</span><strong><%= citizen.created_at ? new Date(citizen.created_at).toLocaleDateString('fr-FR') : '—' %></strong></div>
            </div>
            <div class="citizen-alerts">
                <span class="citizen-flag <%= citizen.wanted ? 'is-active wanted' : '' %>"><i></i><%= citizen.wanted ? 'Personne recherchée' : 'Pas recherché' %></span>
                <span class="citizen-flag <%= citizen.dangerous ? 'is-active dangerous' : '' %>"><i></i><%= citizen.dangerous ? 'Individu dangereux' : 'Pas considéré dangereux' %></span>
            </div>
            <div class="citizen-profile-actions">
                <a href="/citizens/<%= citizen.id %>/edit" class="btn-back citizen-back">Modifier la fiche</a>
                <a href="/citizens" class="btn-back citizen-back">Retour au registre</a>
            </div>
        </div>

        <div class="citizen-information-grid">
            <div class="citizen-info-block"><span>Permis détenus</span><strong><%= citizen.permits || 'Aucun permis renseigné' %></strong></div>
            <div class="citizen-info-block"><span>Véhicules possédés</span><strong><%= citizen.owned_vehicles || 'Aucun véhicule renseigné' %></strong></div>
            <div class="citizen-info-block"><span>Habitations</span><strong><%= citizen.residences || 'Aucune habitation renseignée' %></strong></div>
            <div class="citizen-info-block"><span>Armes enregistrées</span><strong><%= citizen.registered_weapons || 'Aucune arme renseignée' %></strong></div>
        </div>

        <% let citizenPhotos = []; try { citizenPhotos = citizen.photo_paths ? JSON.parse(citizen.photo_paths) : [] } catch (error) { citizenPhotos = [] } %>
        <% if (citizenPhotos.length > 0) { %>
        <div class="citizen-photos-panel">
            <div class="citizen-section-heading">
                <div><p class="section-kicker">Pièces visuelles</p><h2>Photos du dossier</h2></div>
                <span class="reports-count"><%= citizenPhotos.length %> image<%= citizenPhotos.length > 1 ? 's' : '' %></span>
            </div>
            <div class="citizen-photo-grid">
                <% citizenPhotos.forEach(photo => { %><a href="<%= photo %>" target="_blank" rel="noreferrer"><img src="<%= photo %>" alt="Photo du dossier citoyen"></a><% }) %>
            </div>
        </div>
        <% } %>

        <div class="reports-list">
            <div class="citizen-section-heading">
                <div>
                    <p class="section-kicker">Traçabilité opérationnelle</p>
                    <h2>Rapports associés</h2>
                </div>
                <span class="reports-count"><%= reports.length %> rapport<%= reports.length > 1 ? 's' : '' %></span>
            </div>
            <% if (reports.length === 0) { %>
                <p class="empty-dashboard">Aucun rapport lié trouvé.</p>
            <% } else { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Agent</th>
                            <th>Personnes concernées</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reports.forEach(report => { %>
                            <tr>
                                <td><a href="/reports/<%= report.id %>"><%= report.id %></a></td>
                                <td><%= report.type %></td>
                                <td><%= report.agent_username || 'Inconnu' %></td>
                                <td><%= report.personnes_concernees %></td>
                                <td><%= report.created_at ? new Date(report.created_at).toLocaleString('fr-FR') : '—' %></td>
                                <td><a href="/reports/<%= report.id %>">Voir</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>

    </div>

</div>

</body>
</html>