<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FIB - Détails Citoyen</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="layout">

    <div class="sidebar">
        <img src="/images/FIB_V2.png" alt="Logo FIB" class="sidebar-logo">
        <a href="/auth/dashboard">Dashboard</a>
        <a href="/citizens">Citoyens</a>
        <a href="/reports">Rapports</a>
        <a href="/service">Service</a>
        <a href="/messages">Messages</a>
        <% if (user && user.accreditation <= 2) { %>
        <a href="/users/admin">Admin Utilisateurs</a>
        <a href="/logs/admin">Admin Logs</a>
        <% } %>
        <div class="logout">
            <a href="/logout">Déconnexion</a>
        </div>
    </div>

    <div class="main">
        <div class="topbar">
            <div>
                <p class="page-kicker">Dossier citoyen #<%= citizen.id %></p>
                <h1><%= citizen.prenom %> <%= citizen.nom %></h1>
                <p class="subtitle">Fiche consultable dans le registre du FIB</p>
            </div>
        </div>

        <div class="citizen-profile">
            <div class="citizen-profile-identity">
                <div class="citizen-profile-avatar"><%= citizen.prenom.charAt(0).toUpperCase() %><%= citizen.nom.charAt(0).toUpperCase() %></div>
                <div>
                    <p class="section-kicker">Identité enregistrée</p>
                    <h2><%= citizen.prenom %> <%= citizen.nom %></h2>
                    <span class="citizen-status">Dossier actif</span>
                </div>
            </div>
            <div class="citizen-facts">
                <div><span>Référence</span><strong>#<%= citizen.id %></strong></div>
                <div><span>Date de naissance</span><strong><%= new Date(citizen.dob).toLocaleDateString('fr-FR') %></strong></div>
                <div><span>Téléphone</span><strong><%= citizen.phone || 'Non renseigné' %></strong></div>
                <div><span>Profession</span><strong><%= citizen.job || 'Non renseignée' %></strong></div>
                <div><span>Affiliation</span><strong><%= citizen.affiliation || 'Aucune' %></strong></div>
                <div><span>Enregistré le</span><strong><%= citizen.created_at ? new Date(citizen.created_at).toLocaleDateString('fr-FR') : '—' %></strong></div>
            </div>
            <div class="citizen-alerts">
                <span class="citizen-flag <%= citizen.wanted ? 'is-active wanted' : '' %>"><i></i><%= citizen.wanted ? 'Personne recherchée' : 'Pas recherché' %></span>
                <span class="citizen-flag <%= citizen.dangerous ? 'is-active dangerous' : '' %>"><i></i><%= citizen.dangerous ? 'Individu dangereux' : 'Pas considéré dangereux' %></span>
            </div>
            <div class="citizen-profile-actions">
                <a href="/citizens/<%= citizen.id %>/edit" class="btn-back citizen-back">Modifier la fiche</a>
                <form method="POST" action="/citizens/<%= citizen.id %>/delete" onsubmit="return confirm('Supprimer définitivement cette fiche citoyen et ses photos ? Les rapports associés seront conservés.');">
                    <button type="submit" class="btn-back citizen-delete">Supprimer la fiche</button>
                </form>
                <a href="/citizens" class="btn-back citizen-back">Retour au registre</a>
            </div>
        </div>

        <div class="citizen-information-grid">
            <div class="citizen-info-block"><span>Permis détenus</span><strong><%= citizen.permits || 'Aucun permis renseigné' %></strong></div>
            <div class="citizen-info-block"><span>Autres informations véhicules</span><strong><%= citizen.owned_vehicles || 'Non renseigné' %></strong></div>
            <div class="citizen-info-block"><span>Habitations</span><strong><%= citizen.residences || 'Aucune habitation renseignée' %></strong></div>
            <div class="citizen-info-block"><span>Autres informations sur les armes</span><strong><%= citizen.registered_weapons || 'Non renseigné' %></strong></div>
            <section class="citizen-info-block citizen-assets-detail">
                <span>Véhicules identifiés</span>
                <% if (vehicleDetails.length) { %>
                <ul><% vehicleDetails.forEach(vehicle => { %><li><strong><%= vehicle.first || 'Modèle non renseigné' %></strong><small>Plaque : <%= vehicle.second || 'Non renseignée' %></small></li><% }) %></ul>
                <% } else { %><strong>Aucun véhicule détaillé</strong><% } %>
            </section>
            <section class="citizen-info-block citizen-assets-detail">
                <span>Armes identifiées</span>
                <% if (weaponDetails.length) { %>
                <ul><% weaponDetails.forEach(weapon => { %><li><strong><%= weapon.first || 'Type non renseigné' %></strong><small>N° de série : <%= weapon.second || 'Non renseigné' %></small></li><% }) %></ul>
                <% } else { %><strong>Aucune arme détaillée</strong><% } %>
            </section>
        </div>

        <% let citizenPhotos = []; try { citizenPhotos = citizen.photo_paths ? JSON.parse(citizen.photo_paths) : [] } catch (error) { citizenPhotos = [] } %>
        <% if (citizenPhotos.length > 0) { %>
        <div class="citizen-photos-panel">
            <div class="citizen-section-heading">
                <div><p class="section-kicker">Pièces visuelles</p><h2>Photos du dossier</h2></div>
                <span class="reports-count"><%= citizenPhotos.length %> image<%= citizenPhotos.length > 1 ? 's' : '' %></span>
            </div>
            <div class="citizen-photo-grid">
                <% citizenPhotos.forEach((photo, index) => { %>
                <button class="citizen-photo-button" type="button" data-photo-index="<%= index %>" aria-label="Agrandir la photo <%= index + 1 %>">
                    <img src="<%= photo %>" alt="Photo <%= index + 1 %> du dossier citoyen">
                    <span class="photo-zoom-hint" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"></circle><path d="m15.5 15.5 5 5"></path><path d="M10.8 7.5v6.6M7.5 10.8h6.6"></path></svg>
                    </span>
                </button>
                <% }) %>
            </div>
        </div>
        <dialog class="photo-viewer" id="photo-viewer" aria-label="Visionneuse de photos">
            <div class="photo-viewer-header">
                <div>
                    <p class="section-kicker">Pièces visuelles</p>
                    <strong id="photo-viewer-counter">Photo 1 / <%= citizenPhotos.length %></strong>
                </div>
                <button class="photo-viewer-close" type="button" data-photo-close aria-label="Fermer la visionneuse">×</button>
            </div>
            <div class="photo-viewer-stage">
                <button class="photo-viewer-nav photo-viewer-previous" type="button" data-photo-previous aria-label="Photo précédente">‹</button>
                <img id="photo-viewer-image" alt="Photo agrandie du dossier citoyen">
                <button class="photo-viewer-nav photo-viewer-next" type="button" data-photo-next aria-label="Photo suivante">›</button>
            </div>
            <div class="photo-viewer-toolbar">
                <span>Zoom</span>
                <button type="button" data-zoom-out aria-label="Réduire le zoom">−</button>
                <output id="photo-viewer-zoom">100 %</output>
                <button type="button" data-zoom-in aria-label="Agrandir avec la loupe">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"></circle><path d="m15.5 15.5 5 5M10.8 7.5v6.6M7.5 10.8h6.6"></path></svg>
                </button>
                <button class="photo-viewer-reset" type="button" data-zoom-reset>Réinitialiser</button>
            </div>
        </dialog>
        <% } %>

        <div class="reports-list">
            <div class="citizen-section-heading">
                <div>
                    <p class="section-kicker">Traçabilité opérationnelle</p>
                    <h2>Rapports associés</h2>
                </div>
                <span class="reports-count"><%= reports.length %> rapport<%= reports.length > 1 ? 's' : '' %></span>
            </div>
            <% if (reports.length === 0) { %>
                <p class="empty-dashboard">Aucun rapport lié trouvé.</p>
            <% } else { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Agent</th>
                            <th>Personnes concernées</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reports.forEach(report => { %>
                            <tr>
                                <td><a href="/reports/<%= report.id %>"><%= report.id %></a></td>
                                <td><%= report.type %></td>
                                <td><%= report.agent_username || 'Inconnu' %></td>
                                <td><%= report.personnes_concernees %></td>
                                <td><%= report.created_at ? new Date(report.created_at).toLocaleString('fr-FR') : '—' %></td>
                                <td><a href="/reports/<%= report.id %>">Voir</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>

    </div>

</div>

<script src="/js/site-presence.js" data-user-id="<%= user.id %>"></script>
<script src="/js/photo-viewer.js"></script>
</body>
</html>